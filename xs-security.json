{
  "xsappname": "project1",
  "tenant-mode": "dedicated",
  "description": "Security profile of called application",
  "scopes": [
    {
      "name": "$XSAPPNAME.Global_user",
      "description": "Global application access"
    },
    {
      "name": "$XSAPPNAME.read",
      "description": "Read articles"
    },
    {
      "name": "$XSAPPNAME.update",
      "description": "Create and update articles"
    }
  ],
  "role-templates": [
    {
      "name": "ContentCreator",
      "description": "Can read, create and update articles",
      "scope-references": [
        "$XSAPPNAME.read",
        "$XSAPPNAME.update"
      ]
    }
  ]
}